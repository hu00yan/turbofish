  "moonbitlang/async",
  "turbofish/build",
  "turbofish/query",
  "turbofish/store",
  "turbofish/simstore",
  "turbofish/format",
  "turbofish/core",
  "moonbitlang/core/math",
  "moonbitlang/core/bench",
}

options(
  "is-main": true,
  targets: {
    "main.mbt": [ "native" ],
    "extras.mbt": [ "native" ],
    "gen.mbt": [ "native" ],
    "sim.mbt": [ "native" ],
  },
)
