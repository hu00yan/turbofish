#cfg(any(target="native", target="llvm"))
import {
  "moonbitlang/async",
  "turbofish/core",
  "turbofish/build",
  "turbofish/query",
  "turbofish/store",
  "turbofish/s3client",
  "moonbitlang/core/env",
  "moonbitlang/core/bench",
}

// 真实 S3/MinIO 端到端探针（纯 MoonBit 异步 S3Client，不再链接 libcurl）。
options(
  "is-main": true,
  targets: {
    "main.mbt": [ "native" ],
  },
)
