#cfg(any(target="native", target="llvm"))
import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
  "turbofish/build",
  "turbofish/format",
  "turbofish/query",
  "turbofish/store",
  "turbofish/s3store",
  "turbofish/s3http",
  "turbofish/fsstore",
  "turbofish/simstore",
  "turbofish/meta",
  "turbofish/mtree",
  "turbofish/core",
  "turbofish/control",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

options(
  "is-main": true,
  targets: {
    "main.mbt": [ "native" ],
    "branch.mbt": [ "native" ],
    "stub.mbt": [ "wasm", "wasm-gc", "js" ],
    "serve_wbtest.mbt": [ "native" ],
    "branch_wbtest.mbt": [ "native" ],
  },
  link: {
    "native": {
      "cc-link-flags": "-lcurl",
    },
  },
)
