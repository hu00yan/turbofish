// mtree：MergeTree 写路径（对象存储写放大最优的 LSM/MergeTree 系移植）。
//
// 依赖纪律（拔插边界）：
// - 本包不 import turbofish/build / turbofish/query 的任何写路径；
// - turbofish/store 只用于 @store.ObjectStore 之上的后端适配与 head log 原语；
// - turbofish/format **仅** import @format.encode_roaring / decode_roaring
//   做 tombstone 编解码（任务书指定：只 import 使用，不修改它）；
//   不触碰 format 的 manifest/segment 等现有格式。
// - 未来换 OpenDAL / 其它对象存储 client：只替换各 *Store 实现的底层
//   @store.ObjectStore（见 objstore_impls.mbt 注释），本包其余代码零改动。
import {
  "turbofish/core",
  "turbofish/store",
  "turbofish/format",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/test",
}
