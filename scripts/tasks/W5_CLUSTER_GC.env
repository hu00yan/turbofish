ALLOWLIST_REGEX="^(meta|cmd/metad|groupcommit|cmd/supervise)/"
LOCKED_REGEX="^scripts/"
CHECK_TARGETS="meta cmd/metad groupcommit cmd/supervise"
TEST_TARGETS="meta groupcommit"
TIMEOUT_SEC=60
GATE_CMD='test -f groupcommit/buffer.mbt && test -f cmd/supervise/main.mbt && grep -q "/leases/acquire" cmd/metad/main.mbt'
